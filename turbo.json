{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_APP_MAIN_URL",
    "NEXT_PUBLIC_APP_COMMUNITY_URL",
    "NEXT_PUBLIC_APP_SCREENING_URL",
    "NEXT_PUBLIC_APP_BOOKING_URL",
    "NEXT_PUBLIC_APP_RESOURCES_URL",
    "NEXT_PUBLIC_APP_CASES_URL",
    "NEXT_PUBLIC_APP_ADMIN_URL",
    "NEXT_PUBLIC_COMMUNITY_MERGED",
    "NEXT_PUBLIC_MERGED_APPS",
    "NEXT_PUBLIC_COMMUNITY_MOVED_TO",
    "NEXT_PUBLIC_SCREENING_MOVED_TO",
    "NEXT_PUBLIC_BOOKING_MOVED_TO",
    "NEXT_PUBLIC_RESOURCES_MOVED_TO",
    "NEXT_PUBLIC_CASES_MOVED_TO",
    "NEXT_PUBLIC_ADMIN_MOVED_TO",
    "NEXT_PUBLIC_API_DIRECT",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "dev": {
      "cache": false
    },
    "lint": {},
    "type-check": {},
    "clean": {
      "cache": false
    }
  }
}
